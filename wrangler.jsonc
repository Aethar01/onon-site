// ononreader.com is static: Cloudflare serves what `npm run build` puts in dist.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onon-site",
	"compatibility_date": "2026-10-01",
	"routes": [{ "pattern": "ononreader.com", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Pull requests deploy with `wrangler preview`, which needs this block.
	"previews": {}
}
